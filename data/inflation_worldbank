"""
get_inflation_fred.py: downloads annual CPI inflation (%) for the 18 countries
in my research, 1996-2024, from FRED. FRED republishes the World Bank series
FP.CPI.TOTL.ZG for each country under the ID FPCPITOTLZG<ISO3>.

Output: data/inflation_fred.csv, the same layout as cpi_fred.csv:
    observation_date, FPCPITOTLZGPER, FPCPITOTLZGCHL, ...

Run from the repo root:
    python get_inflation_fred.py
"""
import io
import os
from datetime import date

import pandas as pd
import requests

COUNTRIES = {
    # South America
    "PER": "Peru", "CHL": "Chile", "COL": "Colombia",
    # North America
    "MEX": "Mexico", "USA": "United States", "CAN": "Canada",
    # Europe
    "TUR": "Turkiye", "UKR": "Ukraine", "GRC": "Greece",
    # Africa
    "ZWE": "Zimbabwe", "NGA": "Nigeria", "CIV": "Cote d'Ivoire",
    # Oceania
    "FJI": "Fiji", "SLB": "Solomon Islands", "PNG": "Papua New Guinea",
    # Central America
    "HND": "Honduras", "NIC": "Nicaragua", "SLV": "El Salvador",
}
START, END = "1996-01-01", "2024-01-01"
URL = "https://fred.stlouisfed.org/graph/fredgraph.csv"

if __name__ == "__main__":
    os.makedirs("data", exist_ok=True)
    print(f"Downloading FRED inflation series, {START[:4]}-{END[:4]} (run on {date.today()})")

    frames, missing = [], []
    for iso, name in COUNTRIES.items():
        sid = f"FPCPITOTLZG{iso}"
        r = requests.get(URL, params={"id": sid, "cosd": START, "coed": END}, timeout=60)
        if r.status_code != 200 or sid not in r.text.splitlines()[0]:
            missing.append(f"{sid} ({name})")
            continue
        df = pd.read_csv(io.StringIO(r.text), na_values=".")   # FRED marks gaps with "."
        df = df.rename(columns={df.columns[0]: "observation_date"}).set_index("observation_date")
        frames.append(df)
        print(f"  {sid:16s} {name:18s} {df[sid].notna().sum()} years")

    out = pd.concat(frames, axis=1).sort_index()
    out.to_csv("data/inflation_fred.csv", float_format="%.3f")
    print(f"Saved data/inflation_fred.csv: {out.shape[0]} years x {out.shape[1]} countries")
    if missing:
        print("Not found on FRED (use the World Bank file from get_data.py instead):", ", ".join(missing))
